# Native development. Docker Compose generates its own local credentials.
DATABASE_URL=postgres://cardlattice:replace-with-local-password@localhost:5432/cardlattice
BIND=127.0.0.1:8080
PUBLIC_API_ORIGIN=http://localhost:8080
DATASET_DIRECTORY=.local/datasets
# Supply three distinct randomly generated values, at least 32 characters each.
# Prefer *_FILE variables pointing at a secret mount in production.
CONTRIBUTOR_TOKEN=
MODERATOR_TOKEN=
METRICS_TOKEN=
RUST_LOG=info
# Optional; set both or leave both unset. Never required locally.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
