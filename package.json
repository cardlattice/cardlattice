{
  "name": "cardlattice",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@cardlattice/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "pnpm --filter @cardlattice/web test:e2e",
    "format:check": "turbo run format:check",
    "dev:status": "turbo run dev --filter=@cardlattice/status",
    "build:status": "turbo run build --filter=@cardlattice/status"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "wrangler": "4.161.0"
  },
  "packageManager": "pnpm@12.4.1"
}
